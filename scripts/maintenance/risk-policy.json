    "src/server/app.ts",
    "src/server/storage.ts",
    "src/server/persistent-store.ts",
    "src/server/primary-data-repository.ts",
    "src/server/sqlite-*.ts",
    "src/server/github-bidirectional-sync.ts",
    "src/server/archive-*.ts",
    "src/server/restore-*.ts",
    "src/server/sync-*.ts",
    "src/server/security.ts",
    "src/server/library-event-diff.ts",
    "src/server/app-event-bus.ts",
    "src/server/content-*.ts",
    "src/core/taste/**",
    "**/migrations/**",
    "**/*.sql"
